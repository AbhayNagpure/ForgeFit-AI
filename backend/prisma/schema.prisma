generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String?
  goal      String?  
  weight    Float?
  height    Float?
  age       Int?
  gender    String?
  dailyCalories Int?
  dailyProtein  Int?
  experienceLevel String?
  equipment       String?
  workoutDays     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workouts        Workout[]
  weightLogs      WeightLog[]
  personalRecords PersonalRecord[]
  bodyMetrics     BodyMetric[]
  nutritionLogs   NutritionLog[]
  conversations   Conversation[]
  agentRuns        AgentRun[]
  pendingActions   PendingAction[]
  memories         UserMemory[]
}

model NutritionLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodName  String
  calories  Int
  protein   Int
  carbs     Int?
  fat       Int?
  source    String   @default("manual")
  confidence Float?
  date      DateTime @default(now())
}

model Workout {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String
  duration  Int
  date      DateTime @default(now())
  
  exercises WorkoutExercise[]
}

model WeightLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float
  date      DateTime @default(now())
}

model WorkoutExercise {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  workoutId String   @db.ObjectId
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String
  sets      Int
  reps      Int
  weight    Float?   
  order     Int      @default(0)
  notes     String?
  completedSets WorkoutSet[]
}

model WorkoutSet {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  exerciseId String          @db.ObjectId
  exercise   WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setNumber  Int
  reps       Int
  weight     Float?
  rpe        Float?
  rir        Int?
  completed  Boolean         @default(true)
  createdAt  DateTime        @default(now())
}

model PersonalRecord {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseName String
  weight       Float
  reps         Int?
  date         DateTime @default(now())
}

model BodyMetric {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyFat   Float?
  chest     Float?
  arms      Float?
  waist     Float?
  thighs    Float?
  sleep     Float?
  date      DateTime @default(now())
}

model Conversation {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  userId    String        @db.ObjectId
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  summary   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  runs      AgentRun[]
  pendingActions PendingAction[]
}

model ChatMessage {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())
}

model AgentRun {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  userId         String        @db.ObjectId
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?       @db.ObjectId
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  requestId      String        @unique
  model          String
  status         String        @default("running")
  input          String
  output         String?
  turnCount      Int           @default(0)
  inputTokens    Int?
  outputTokens   Int?
  durationMs     Int?
  error          String?
  createdAt      DateTime      @default(now())
  completedAt    DateTime?
  toolExecutions ToolExecution[]
}

model ToolExecution {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  agentRunId       String   @db.ObjectId
  agentRun         AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  name             String
  arguments        Json
  result           Json?
  status           String
  durationMs       Int?
  requiresApproval Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model PendingAction {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  userId         String        @db.ObjectId
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?       @db.ObjectId
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  toolName       String
  arguments      Json
  description    String
  status         String        @default("pending")
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?
}

model UserMemory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  value      String
  category   String   @default("preference")
  confidence Float    @default(1)
  source     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, key])
}
